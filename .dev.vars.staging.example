# Staging Wrangler secrets (gitignored as `.dev.vars.staging`).
# Used by `wrangler dev --env staging`. Do not reuse production DATABASE_URL.
# BETTER_AUTH_URL comes from wrangler.toml [env.staging.vars]; omit it here.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=generate-a-long-random-string
RESEND_API_KEY=
DEMO_EMAIL=demo@locations.app
DEMO_PASSWORD=
# Stripe TEST-mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
