# Production Wrangler secrets (gitignored as `.dev.vars.production`).
# Used by `wrangler dev --env production`. Live Stripe keys only.
# BETTER_AUTH_URL comes from wrangler.toml [env.production.vars]; omit it here.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=generate-a-long-random-string
RESEND_API_KEY=
# When the API key is set, EMAIL_FROM must be a verified Resend domain.
EMAIL_FROM=Locations <noreply@example.com>
DEMO_EMAIL=demo@locations.app
DEMO_PASSWORD=
# Stripe LIVE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
