# Local CLI / Node (gitignored as `.env`).
# Other environments: `.env.staging` / `.env.production` from the matching *.example files.
# Staging and production must use separate Neon databases. Never copy prod DATABASE_URL into staging.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787

# Public signup kill switch (default: signup allowed)
DISABLE_SIGNUP=false

# Optional MapLibre globe of heatmap points
GLOBE_ENABLED=true
# Public marketing landing at / (false keeps unauthenticated / as sign-in)
LANDING_ENABLED=true
# Scripted overlay for the demo role
DEMO_TOUR=true

# Content-Security-Policy: set true to enforce (default is Report-Only)
CSP_ENFORCE=false

# Email (Resend). Required for verify, magic link, OTP, and status mail in production.
# When RESEND_API_KEY is set, EMAIL_FROM must be a verified Resend domain.
# Unset RESEND_API_KEY to skip send (local/dev is fine; the app does not throw).
RESEND_API_KEY=
EMAIL_FROM=Locations <noreply@example.com>

# Demo login (server-only; never put these in VITE_* or the web bundle)
DEMO_EMAIL=demo@locations.app
DEMO_PASSWORD=

# Stripe (omit STRIPE_SECRET_KEY to allow import without a subscription, for self-host)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
GRACE_DAYS=3

# Maps / routing (commercial URLs for production SaaS)
MAP_TILE_DARK_URL=
MAP_TILE_LIGHT_URL=
MAP_TILE_ATTR=
MAP_STYLE_DARK_URL=
MAP_STYLE_LIGHT_URL=
MAP_CUSTOM_TILE_HOSTS=
OSRM_BASE=
GEOCODE_BASE=

# Optional default path for CLI import (relative to repo root).
DATA_PATH=data/sample-location-history.json
