{
  "name": "locations",
  "version": "1.0.0",
  "private": true,
  "description": "Private location history explorer - Cloudflare Workers + Neon + Better Auth",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:all": "npm run build:web && concurrently -n web,api -c cyan,magenta \"npm run dev -w @locations/web\" \"npm run dev -w @locations/api\"",
    "dev:web": "npm run dev -w @locations/web",
    "dev:api": "npm run dev -w @locations/api",
    "build:all": "npm run build -w @locations/web && npm run build -w @locations/api",
    "build:web": "npm run build -w @locations/web",
    "deploy:staging": "npm run build:all && node scripts/deploy.mjs staging",
    "deploy:prod": "npm run build:all && node scripts/deploy.mjs production",
    "deploy:both": "npm run build:all && node scripts/deploy.mjs staging && node scripts/deploy.mjs production",
    "deploy:preview": "npm run build:all && node scripts/deploy.mjs staging --preview",
    "db:generate": "npm run generate -w @locations/db",
    "db:migrate:dev": "npm run migrate -w @locations/db -- --env local",
    "db:migrate:staging": "npm run migrate -w @locations/db -- --env staging",
    "db:migrate:prod": "npm run migrate -w @locations/db -- --env production",
    "db:migrate:all": "npm run db:migrate:dev && npm run db:migrate:staging && npm run db:migrate:prod",
    "db:import": "npm run import -w @locations/db",
    "db:import-demo": "node scripts/import-demo.mjs",
    "db:warm-routes": "npm run warm-routes -w @locations/db",
    "env:merge": "node scripts/env.mjs merge",
    "env:sync": "node scripts/env.mjs sync",
    "secrets:generate": "node scripts/secrets.mjs",
    "secrets:rotate": "node scripts/secrets.mjs --rotate",
    "cf:sync": "node scripts/cf-sync.mjs",
    "cf:sync:staging": "node scripts/cf-sync.mjs --env staging",
    "cf:sync:prod": "node scripts/cf-sync.mjs --env production",
    "cf:sync:dry": "node scripts/cf-sync.mjs --dry-run",
    "auth:create-user": "npm run create-user -w @locations/db",
    "auth:create-demo": "npm run create-user -w @locations/db -- demo@locations.app demo1234 Demo demo",
    "auth:promote-admin": "npm run promote-user -w @locations/db -- admin",
    "auth:promote-developer": "npm run promote-user -w @locations/db -- developer",
    "setup:project": "node scripts/setup.mjs",
    "typecheck:all": "npm run typecheck -w @locations/web && npm run typecheck -w @locations/api && npm run typecheck -w @locations/db",
    "lint:web": "npm run lint -w @locations/web",
    "rules:sync": "node scripts/sync-rules.mjs",
    "test:placement": "node scripts/test-placement.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:admin": "vitest run --project admin",
    "test:rls": "vitest run --project rls",
    "test:security": "node scripts/test-security.mjs",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:report": "node scripts/test-report.mjs",
    "loc": "node scripts/loc.mjs",
    "loc:report": "node scripts/loc.mjs --report",
    "kill:servers": "node scripts/kill-servers.mjs",
    "deps:audit": "npm audit --audit-level=high",
    "git:merge-master": "node scripts/merge-master-into-branches.mjs --push",
    "git:merge-master:preview": "node scripts/merge-master-into-branches.mjs --preview --push",
    "git:merge-master:fetch": "node scripts/merge-master-into-branches.mjs --fetch --push"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.113.0"
  },
  "engines": {
    "node": ">=20"
  }
}
