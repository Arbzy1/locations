# Local Wrangler secrets (gitignored as `.dev.vars`). Used by `wrangler dev` (no --env).
# Other environments: `.dev.vars.staging` / `.dev.vars.production`.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=dev-secret-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787
# Google OAuth (optional). Redirect: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# When the API key is set, EMAIL_FROM must be a verified Resend domain.
EMAIL_FROM=Locations <noreply@example.com>
DEMO_EMAIL=demo@locations.app
DEMO_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
GRACE_DAYS=3
MAP_TILE_DARK_URL=
MAP_TILE_LIGHT_URL=
MAP_TILE_ATTR=
MAP_STYLE_DARK_URL=
MAP_STYLE_LIGHT_URL=
MAP_CUSTOM_TILE_HOSTS=
OSRM_BASE=
GEOCODE_BASE=
