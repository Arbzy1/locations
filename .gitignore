# =============================================================================
# .gitignore - Locations monorepo
# =============================================================================

# ----- Dependencies -----
node_modules/
**/node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.pnp.js
bower_components/
jspm_packages/

# ----- Build / bundler / Workers -----
dist/
dist-ssr/
build/
out/
.output/
.vercel/
.netlify/
.wrangler/
.wrangler-bundle/
.vite/
.turbo/
.parcel-cache/
.cache/
.sass-cache/
*.tsbuildinfo
*.esm.js.map
*.cjs.js.map
wrangler.toml.local

# ----- Env / secrets (never commit) -----
.env
.env.*
!.env.example
!.env*.example
.dev.vars
!.dev.vars.example
.generated-secret.txt
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
credentials.json
secrets.json
secrets/
.secret
**/service-account*.json
**/google-credentials*.json

# ----- Personal / private location data -----
# Real Takeout exports - never commit. Sample data under data/ is OK.
location-history.json
**/location-history.json
../location-history.json
*-location-history.json
!data/sample-location-history.json
**/Records.json
**/Semantic Location History/
*.mbox
Takeout/
**/Takeout/
takeout-*/

# ----- Databases / local caches -----
*.db
*.sqlite
*.sqlite3
cache/
**/cache.db
legacy/cache/

# ----- Tests / coverage / Playwright -----
coverage/
.nyc_output/
htmlcov/
.jest/
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/
*.lcov

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
wrangler-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Editors / IDEs -----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/settings.json.example
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.classpath
.settings/

# ----- Agent / AI local state (keep committed rule sources) -----
.claude/
.aider*
!.aider.conf.yml
.codex/
.continual-learning/
.agents/
.cursor/*
!.cursor/rules/
!.cursor/mcp.json

# ----- Legacy local artifacts -----
legacy/cache/
backend/
frontend/
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Misc junk -----
*.bak
*.tmp
*.temp
*.orig
*.old
*.rej
.eslintcache
.stylelintcache
*.local
*.local.json
.local/
tmp/
temp/
cookies.txt
demo-cookies.txt
*-cookies.txt
signin.json
demo-signin.json
day12.json
.fleet/
.history/
